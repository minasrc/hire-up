NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

NEXTAUTH_URL=http://127.0.0.1:3000
NEXTAUTH_SECRET=replace-with-a-local-development-secret

# Optional. Required only by features that send email.
RESEND_API_KEY=

# Google OAuth — the only sign-in provider (staff workspace and invite claims).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Staff database access for resolving staff principals (server-only).
# postgres://postgres:<password>@db.<ref>.supabase.co:5432/postgres
STAFF_DATABASE_URL=
# Seeded staff organization UUID.
STAFF_ORGANIZATION_ID=9c4edd11-2571-490b-a87c-ef30b9e0a001

# Public intake database access — anonymous job board reads and application
# submissions (app_intake role, server-only).
# postgres://postgres:<password>@db.<ref>.supabase.co:5432/postgres
INTAKE_DATABASE_URL=

# Optional bounded reply context for the existing extraction provider; defaults off.
TELEGRAM_EXTRACTION_CONTEXT_ENABLED=false
