{
  "name": "agora-web3-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "dev:design": "next dev design-preview --webpack --hostname 127.0.0.1 --port 3100",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/unit/*.test.js",
    "test:db:foundation": "node --test tests/database/foundation.test.js",
    "test:db:staff": "node --test tests/database/staff-authorization.test.js",
    "test:db:privacy": "node --test tests/database/privacy-foundation.test.js",
    "test:db:privacy-operations": "node --test tests/database/privacy-operations.test.js",
    "test:db:client-jobs": "node --test tests/database/client-job-workflows.test.js",
    "test:db:recruitment": "node --test tests/database/recruitment-workspace.test.js",
    "test:db:totp": "node --test tests/database/staff-totp.test.js",
    "test:staff-workspace": "node --test tests/database/staff-workspace.test.js tests/database/recruitment-workspace.test.js tests/staff-workspace/workspace.test.js",
    "test:e2e": "playwright test",
    "test:e2e:backend": "E2E_REAL_BACKEND=1 playwright test tests/e2e/application-backend.spec.js",
    "local:start": "supabase start",
    "local:status": "supabase status",
    "local:reset": "supabase db reset",
    "local:stop": "supabase stop"
  },
