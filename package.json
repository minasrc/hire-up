{
  "name": "agora-web3-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "dev:design": "next dev design-preview --webpack --hostname 127.0.0.1 --port 3100",
    "dev:staff-fixture": "node scripts/dev-staff-fixture.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/unit/*.test.js",
    "test:db:foundation": "node --test tests/database/foundation.test.js",
    "test:db:staff": "node --test tests/database/staff-authorization.test.js",
    "test:db:privacy": "node --test tests/database/privacy-foundation.test.js",
    "test:db:privacy-operations": "node --test tests/database/privacy-operations.test.js",
    "test:db:client-jobs": "node --test tests/database/client-job-workflows.test.js",
    "test:db:totp": "node --test --test-concurrency=1 tests/database/staff-totp.test.js tests/database/staff-time-zone.test.js",
    "test:staff-workspace": "node --test --test-concurrency=1 tests/database/staff-workspace.test.js tests/database/staff-list-pagination.test.js tests/database/candidate-profiles.test.js tests/staff-workspace/workspace.test.js tests/staff-workspace/record-preview.test.js",
    "test:duplicate-review": "node --test --test-concurrency=1 tests/database/candidate-merge.test.js tests/staff-workspace/duplicate-review.test.js",
    "test:e2e": "playwright test",
    "test:e2e:backend": "E2E_REAL_BACKEND=1 playwright test tests/e2e/application-backend.spec.js",
    "local:start": "supabase start",
    "local:status": "supabase status",
    "local:reset": "supabase db reset",
    "local:stop": "supabase stop",
    "test:db:candidate-upload": "node --test tests/database/candidate-upload.test.js",
    "test:telegram-intake": "node --test --test-concurrency=1 tests/database/telegram-intake.test.js tests/staff-workspace/telegram-intake.test.js",
    "test:telegram-connection": "node --test --test-concurrency=1 tests/database/telegram-connection.test.js tests/database/telegram-hosted.test.js tests/database/telegram-enrollment-lifecycle.test.js tests/staff-workspace/telegram-connection.test.js tests/staff-workspace/telegram-hosted.test.js",
    "test:telegram-history": "node --test --test-concurrency=1 tests/database/telegram-history.test.js tests/database/telegram-history-progress.test.js tests/database/telegram-chat-removal.test.js tests/database/telegram-hosted-maintenance.test.js tests/database/telegram-history-runtime.test.js tests/database/telegram-sync-runtime.test.js tests/staff-workspace/telegram-history.test.js",
    "test:telegram-extraction": "node --test --test-concurrency=1 tests/database/telegram-extraction.test.js tests/database/telegram-extraction-runtime.test.js tests/database/telegram-extraction-context.test.js tests/staff-workspace/telegram-extraction.test.js tests/evals/telegram-context/harness.test.mjs",
    "test:telegram-cv": "node --test --test-concurrency=1 tests/database/telegram-cv.test.js tests/database/telegram-cv-runtime.test.js tests/staff-workspace/telegram-cv.test.js",
    "test:profile-search": "node --test --test-concurrency=1 tests/database/profile-search.test.js tests/database/profile-search-runtime.test.js tests/staff-workspace/profile-search.test.js",
    "test:telegram-retention": "node --test --test-concurrency=1 tests/database/telegram-retention.test.js tests/database/telegram-retention-runtime.test.js tests/staff-workspace/telegram-retention.test.js",
    "test:cv-analysis": "CV_PARSER_DOCKER=1 node --test --test-concurrency=1 tests/database/cv-analysis-parser.test.js tests/database/cv-analysis.test.js tests/database/cv-analysis-runtime.test.js tests/staff-workspace/cv-analysis.test.js",
    "test:cv-search": "node --test --test-concurrency=1 tests/database/cv-search.test.js tests/database/cv-search-relevance.test.js tests/database/cv-search-scale.test.js tests/staff-workspace/cv-search.test.js",
    "test:worker-pairing": "node --test --test-concurrency=1 tests/database/worker-pairing.test.js tests/database/worker-pairing-runtime.test.js tests/staff-workspace/worker-pairing.test.js",
    "test:telegram-context": "node --test --test-concurrency=1 tests/database/telegram-context.test.js tests/database/telegram-candidate-context.test.js tests/staff-workspace/telegram-context.test.js",
    "test:telegram-source-updates": "node --test --test-concurrency=1 tests/database/telegram-source-updates-runtime.test.js tests/database/telegram-source-refresh-runtime.test.js tests/database/telegram-native-account-runtime.test.js tests/database/telegram-native-channel-runtime.test.js",
    "test:telegram-context-eval": "node tests/evals/telegram-context/run.mjs"
  },
  "dependencies": {
    "@heroui/accordion": "^2.2.25",
    "@heroui/react": "^2.8.6",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-three/drei": "9.122.0",
    "@react-three/fiber": "8.18.0",
    "@supabase/supabase-js": "^2.97.0",
    "@tailwindcss/vite": "^4.1.13",
    "@tiptap/core": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "file-type": "^21.3.2",
    "framer-motion": "^12.31.0",
    "i18n-iso-countries": "^7.14.0",
    "lucide-react": "^0.561.0",
    "mammoth": "^1.13.0",
    "motion": "^12.23.24",
    "next": "^16.0.10",
    "next-auth": "^4.24.13",
    "ogl": "^1.0.11",
    "pdfjs-dist": "^5.7.284",
    "qrcode": "^1.5.4",
    "radix-ui": "1.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0",
    "react-slick": "^0.31.0",
    "resend": "^6.9.2",
    "server-only": "^0.0.1",
    "slick-carousel": "^1.8.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.160.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.1.6",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.2.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.4.23",
    "dotenv": "^17.3.1",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.1.6",
    "fflate": "^0.8.3",
    "pg": "8.16.3",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "supabase": "^2.39.2",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3"
  }
}
