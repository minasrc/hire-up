    "autoprefixer": "^10.4.23",
    "dotenv": "^17.3.1",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.1.6",
    "fflate": "^0.8.3",
    "pg": "8.16.3",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "supabase": "^2.39.2",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3"
  }
